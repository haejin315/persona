# Default route: the Claude Code CLI on your Claude subscription (`claude` must be on PATH and logged in).
# Specs are "provider:model": claude-cli:sonnet | claude-cli:haiku | claude-cli:opus | openai:gpt-5-mini | ollama:qwen2.5:7b
CHAT_MODEL=claude-cli:sonnet
# Long-term memory consolidation (cheap; runs every few turns)
MEMORY_MODEL=claude-cli:haiku
# Eval judge when the experiment config has no judgeModel and --judge is not given
JUDGE_MODEL=claude-cli:opus
# CLAUDE_CLI_BIN=claude

# OpenAI (optional alternative provider; adapter is ready — set a key to enable "openai:<model>")
# OPENAI_API_KEY=sk-...

# Ollama (local open-source models, OpenAI-compatible API)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Anthropic API (optional, not wired yet)
# ANTHROPIC_API_KEY=

# LLM observability (optional). Langfuse self-hosted: `docker compose up -d` in a langfuse checkout → http://localhost:3000
# Every provider call becomes a traced generation; eval scores attach to the conversation's trace.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=http://localhost:3000   # or https://cloud.langfuse.com / us.cloud.langfuse.com / jp.cloud.langfuse.com
