# OpenAI (primary provider)
OPENAI_API_KEY=sk-...
# Model used for the character's replies by default (see docs/01-unit-economics.md)
CHAT_MODEL=gpt-5-mini
# Model used for long-term memory consolidation (cheap; runs every few turns)
MEMORY_MODEL=gpt-5-nano
# Model used by the eval judge when the experiment config has no judgeModel and --judge is not given.
# Plain name = OpenAI. Experiment configs default to "claude-cli:sonnet" = grade through the Claude Code
# CLI on the user's subscription (no API credit). Requires `claude` on PATH and a logged-in session.
JUDGE_MODEL=gpt-5
# CLAUDE_CLI_BIN=claude

# Ollama (local open-source models, OpenAI-compatible API)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Anthropic (optional, adapter is ready — set a key to enable)
# ANTHROPIC_API_KEY=
